{
  "functions": {
    "api/kb/ingest.ts": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    },
    "api/taxes-product.ts": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "exportfrancefacile.com" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.exportfrancefacile.com" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/mpl-logo.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/rss",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/lead-callback", "destination": "/api/contact?mode=lead-callback" },
    { "source": "/api/business-contact", "destination": "/api/contact?mode=business-contact" },
    { "source": "/api/delete-data", "destination": "/api/contact?mode=delete-data" },
    { "source": "/api/lead", "destination": "/api/lead-magnet?mode=lead" },
    { "source": "/api/pdf", "destination": "/api/lead-magnet?mode=pdf" },
    { "source": "/api/alerts", "destination": "/api/lead-magnet?mode=alerts" },
    { "source": "/api/prefs", "destination": "/api/lead-magnet?mode=prefs" },
    { "source": "/api/export/brief", "destination": "/api/lead-magnet?mode=export-brief" },
    { "source": "/api/hs/search", "destination": "/api/hs?mode=search" },
    { "source": "/api/hs/quota", "destination": "/api/hs?mode=quota" },
    { "source": "/api/ask", "destination": "/api/chat?mode=ask" },
    { "source": "/api/chat-ingest", "destination": "/api/chat?mode=ingest" },
    { "source": "/api/business-deal-chat", "destination": "/api/chat?mode=business-deal" },
    { "source": "/api/invoice/analyze", "destination": "/api/taxes-product?mode=invoice-analyze" },
    { "source": "/api/go-no-go", "destination": "/api/taxes-product?mode=go-no-go" },
    { "source": "/api/stripe/checkout", "destination": "/api/stripe?mode=checkout" },
    { "source": "/api/stripe/portal", "destination": "/api/stripe?mode=portal" },
    { "source": "/api/stripe/webhook", "destination": "/api/stripe?mode=webhook" },
    { "source": "/api/cron/purge", "destination": "/api/system?mode=purge" },
    { "source": "/api/ingest/feeds", "destination": "/api/system?mode=ingest-feeds" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
