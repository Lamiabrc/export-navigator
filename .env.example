# Export Navigator - example environment file
# Copy to .env.local (frontend) and/or configure on Vercel for API routes.

# -----------------------------
# Frontend (Vite)
# -----------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ENABLE_TERRITORIES=false
VITE_GO_NO_GO_MOCK=false
VITE_ADMIN_EMAILS=admin@example.com

# -----------------------------
# Backend (Vercel API / scripts)
# -----------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional aliases used by some scripts:
SUPABASE_SERVICE_ROLE=
SUPABASE_SERVICE_KEY=

# Keep raw value without quotes, e.g. sk-proj-xxxx
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------
# Billing (Stripe)
# -----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONLINE=
STRIPE_PRICE_VISIO=
STRIPE_PRICE_PILOTAGE_HEBDO=
STRIPE_PRICE_PILOTAGE=
STRIPE_PRICE_PROSPECTION=
APP_URL=https://your-domain.example

# -----------------------------
# Email and contact
# -----------------------------
EMAIL_TRANSPORT_URL=smtp://user:pass@smtp.example.com:587
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Export Navigator <no-reply@your-domain.example>
CONTACT_NOTIFICATION_EMAILS=ops@example.com

# -----------------------------
# Scheduled jobs and quotas
# -----------------------------
CRON_SECRET=replace_with_long_random_value
# Optional alias read by purge route:
CRON_TOKEN=
FREE_DAILY_LIMIT=20
IP_HASH_PEPPER=replace_with_long_random_value

# -----------------------------
# Admin allowlist for ingest endpoints (comma-separated)
# -----------------------------
ADMIN_EMAILS=admin@example.com
APP_ADMIN_EMAILS=admin@example.com
